{
  "name": "wa-sync-viewer",
  "version": "1.0.0",
  "description": "CLI tool to connect to WhatsApp, sync recent history, view messages, and send messages",
  "type": "module",
  "scripts": {
    "start": "npx tsx src/index.ts",
    "start:pairing": "npx tsx src/index.ts --pairing-code",
    "send": "npx tsx src/index.ts --send"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^7.0.0-rc.9",
    "node-cache": "^5.1.2",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
